# Copiar a .env y completar con las credenciales del .env raiz.
# Codificar caracteres especiales de usuario/password para una URL.
# No se interpolan variables del archivo de Compose.
DATABASE_URL=postgresql://inventario:REEMPLAZAR_PASSWORD_DESARROLLO@127.0.0.1:5432/inventario
TEST_DATABASE_URL=postgresql://inventario_test:REEMPLAZAR_PASSWORD_PRUEBAS@127.0.0.1:5433/inventario_test
PORT=3000
NODE_ENV=development
